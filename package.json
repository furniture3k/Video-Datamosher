{
  "name": "moshpit",
  "private": true,
  "version": "1.16.3",
  "description": "Video editor with a datamosher built in, for the browser and desktop",
  "license": "GPL-3.0-or-later",
  "homepage": "https://furniture3k.github.io/Video-Datamosher/",
  "repository": {
    "type": "git",
    "url": "https://github.com/furniture3k/Video-Datamosher.git"
  },
  "bugs": {
    "url": "https://github.com/furniture3k/Video-Datamosher/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg-core.mjs && vite",
    "build": "node scripts/copy-ffmpeg-core.mjs && vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-ui.mjs && node scripts/e2e-a11y.mjs && node scripts/e2e-screens.mjs",
    "test:a11y": "node scripts/e2e-a11y.mjs",
    "test:screens": "node scripts/e2e-screens.mjs",
    "desktop": "node scripts/fetch-ffmpeg.mjs --dev && tauri dev",
    "desktop:build": "node scripts/fetch-ffmpeg.mjs && tauri build",
    "desktop:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "tauri": "tauri",
    "test:desktop": "node scripts/e2e-desktop.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@tauri-apps/api": "^2.12.3",
    "mediabunny": "1.61.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^26.6.5",
    "axe-core": "4.14.0",
    "marked": "18.1.1",
    "playwright-core": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
