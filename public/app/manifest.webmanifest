{
  "name": "moshpit",
  "short_name": "moshpit",
  "description": "Video editor with a datamosher built in. Everything runs on your device.",
  "id": "../",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b0d",
  "theme_color": "#0b0b0d",
  "categories": [
    "photo",
    "entertainment",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/*": [
          ".mp4",
          ".mov",
          ".m4v",
          ".webm",
          ".mkv",
          ".avi"
        ],
        "image/gif": [
          ".gif"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".m4a",
          ".flac",
          ".ogg"
        ],
        "application/x-moshpit-recipe": [
          ".moshrecipe"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/*",
            "audio/*"
          ]
        }
      ]
    }
  }
}
