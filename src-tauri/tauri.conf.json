{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moshpit",
  "version": "../package.json",
  "identifier": "io.github.furniture3k.moshpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "moshpit",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0c0c0c",
        "dragDropEnabled": false,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Video editor with a datamosher built in",
    "longDescription": "Cut clips, music and titles together on a multi-track timeline, then datamosh the result by editing the compressed frames directly.",
    "copyright": "moshpit contributors",
    "externalBin": [
      "binaries/moshpit-ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "licenseFile": "../LICENSE",
    "license": "GPL-3.0-or-later",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "binaries/FFMPEG-NOTICE.txt": "FFMPEG-NOTICE.txt"
    },
    "homepage": "https://github.com/furniture3k/Video-Datamosher",
    "publisher": "moshpit contributors"
  }
}
